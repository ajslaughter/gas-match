# Price source mode: "estimated" (default, no key) or "live" (stubbed — plug in your adapter)
PRICE_MODE=estimated

# Contact email for Nominatim/Overpass/AAA User-Agent header (polite usage).
# All three services are free but expect a real identifier. Use your project email.
CONTACT_EMAIL=dev@example.com

# Optional: EIA v2 API key (https://www.eia.gov/opendata/). Used only as a
# fallback for the /map state choropleth when AAA parsing fails. Leave empty
# to disable the fallback.
EIA_API_KEY=
